{
  "name": "purchase-requisition-bottleneck-tracker",
  "version": "1.0.0",
  "description": "SAP CAP application for tracking Purchase Requisition bottlenecks with AI-based risk prediction",
  "author": "SAP CAP Developer",
  "license": "ISC",

  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/pr-bottleneck-tracker.git"
  },

  "engines": {
    "node": ">=18.0.0"
  },

  "dependencies": {
    "@sap/cds": "^9",
    "express": "^4"
  },

  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "cds-plugin-ui5": "^0.17.0"
  },

  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch-project1": "cds watch --open procurement.tracker.project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "build": "cds build",
    "deploy": "cds deploy --to sqlite",
    "deploy-db": "node deploy-db.js",
    "test": "jest"
  },

  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "database": "db.sqlite"
        }
      },
      "auth": {
        "kind": "mocked"
      }
    },

    "features": {
      "fetch_csrf": true
    }
  },

  "private": true,

  "workspaces": [
    "app/*"
  ],

  "sapux": [
    "app/project1"
  ]
}